            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Jones Atualizado\",\n  \"email\": \"bob.updated@example.com\",\n  \"role\": \"Client\",\n  \"isVip\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{clientStandardUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{clientStandardUserId}}"]
