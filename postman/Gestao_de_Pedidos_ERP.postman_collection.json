              "raw": "{{baseUrl}}/orders/{{orderId}}/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "reserve"]
            },
            "description": "Inicia a separação física e bloqueia o saldo de estoque com Lock Pessimista (Transição APPROVED -> RESERVED). Registra no log de auditoria `stock_movements`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.10 Concluir Separação / Faturar Pedido (Estoque - Joe)",
          "request": {
            "method": "POST",
            "header": [
