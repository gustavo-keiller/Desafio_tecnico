{
  "info": {
    "_postman_id": "a8f3b2d1-9c8e-4a7b-b5d3-8e1f0c2a9d4e",
    "name": "Gestão de Pedidos ERP - API Collection",
    "description": "Collection completa para testes da API de Gestão de Pedidos, Concorrência de Estoque, Fila com Prioridade e Matriz RBAC Granular.\n\n### Perfis Pré-configurados (Header `x-user-id`):\n- **Super Admin**: `44444444-4444-4444-4444-444444444444`\n- **Vendedor (Sally)**: `66666666-6666-6666-6666-666666666666`\n- **Gerente de Estoque (Joe)**: `33333333-3333-3333-3333-333333333333`\n- **Cliente VIP (Alice)**: `11111111-1111-1111-1111-111111111111`\n- **Cliente Padrão (Bob)**: `22222222-2222-2222-2222-222222222222`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Pedidos (Orders)",
      "description": "Endpoints do ciclo de vida de pedidos: Criação -> Aprovação -> Reserva (Separação) -> Conclusão (Faturamento) ou Cancelamento.",
      "item": [
        {
          "name": "1.1 Listar Pedidos (Filtros & Paginação)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{activeUserId}}",
                "type": "text",
                "description": "ID do usuário autenticado"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=10&status=&search=",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "ORDERED, APPROVED, RESERVED, FINISHED, CANCELED"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Busca por ID ou nome do cliente"
                }
              ]
            },
            "description": "Lista pedidos. Se executado como Cliente, retorna apenas seus próprios pedidos. Se Admin/Vendedor/Estoque, lista todos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.data && response.data.length > 0) {",
                  "    pm.collectionVariables.set(\"orderId\", response.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Obter Pedido por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{activeUserId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Obtém detalhes do pedido com itens e dados do cliente."
